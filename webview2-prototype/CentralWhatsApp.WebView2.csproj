    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CentralWhatsApp.WebView2</AssemblyName>
    <RootNamespace>CentralWhatsApp.WebView2</RootNamespace>
    <Product>Central WhatsApp</Product>
