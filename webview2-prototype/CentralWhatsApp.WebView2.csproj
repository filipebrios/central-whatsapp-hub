<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MODUX</AssemblyName>
    <RootNamespace>CentralWhatsApp.WebView2</RootNamespace>
    <Product>MODUX</Product>
    <Company>MODUX</Company>
    <Description>Sistema de Gestão Multicontas Corporativo</Description>
    <AssemblyTitle>MODUX</AssemblyTitle>
    <ApplicationIcon>assets\\modux.ico</ApplicationIcon>
    <Version>1.5.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="assets\\modux-icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="assets\\modux.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
